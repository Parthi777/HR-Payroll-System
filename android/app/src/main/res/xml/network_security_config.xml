<?xml version="1.0" encoding="utf-8"?>
<!--
  The shipped configuration: HTTPS only, no exceptions.

  Stated rather than inherited. Android's own default blocks cleartext only from
  API 28, and this app's minSdk is 24 — so on an API 24-27 device, saying
  nothing here would permit plain HTTP to anywhere. CLAUDE.md's security section
  requires HTTPS for all API communication; this is where that holds.

  The development exceptions for a LAN backend and the emulator live in
  src/debug/res/xml/network_security_config.xml, which replaces this file in
  debug builds and is not part of a release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
