// Prisma schema — AI HR Payroll System
// Database: SQLite for local dev (zero-infra). Switch `provider` to "postgresql"
// for production — see CLAUDE.md "Database Schema". Enums are modelled as String
// (with documented allowed values) because the SQLite connector has no native enums;
// the values match shared/types/enums.ts and migrate 1:1 to Postgres enums.
//
// Allowed values:
//   EmployeeStatus  : ACTIVE | INACTIVE | SUSPENDED
//   GeofenceStatus  : INSIDE | OUTSIDE | BORDERLINE
//   AttendanceStatus: PRESENT | ABSENT | LATE | HALF_DAY | ON_LEAVE | HOLIDAY
//   PunchMode       : GEO | MANUAL | SELFIE
//   LeaveType       : CL | SL | EL | LOP | HALF_DAY
//   LeaveStatus     : PENDING | APPROVED | REJECTED | CANCELLED
//   ClaimType       : expense-head list — see services/claim/claim-types.ts
//   ClaimStatus     : PENDING | APPROVED | REJECTED | NEEDS_CLARIFICATION | PAID
//   PayslipStatus   : DRAFT | FINALIZED | WITHHELD | SENT | PAID
//   WAStatus        : QUEUED | SENT | DELIVERED | READ | FAILED
//   AdminRole       : SUPER_ADMIN | HR_MANAGER | BRANCH_MANAGER | PAYROLL_ADMIN | CASHIER
//   TenantStatus    : ACTIVE | SUSPENDED

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Core models
// ─────────────────────────────────────────────────────────────

model Employee {
  id                 String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId           String
  employeeCode       String
  name               String
  phone              String
  email              String?
  branchId           String
  departmentId       String
  designationId      String
  shiftId            String
  faceTemplateUrl    String? // Stored face enrollment image
  faceTemplateId     String? // Rekognition face ID
  deviceId           String? // Device fingerprint binding
  driveFolderId      String? // Google Drive folder id holding this employee's claim files
  passwordHash       String? // bcrypt; set by admin at creation — employee logs in with phone + password
  reportingManagerId String? // AdminUser id — approvals (leave / outside check-in) route to this manager
  pfEnabled          Boolean  @default(false) // PF deduction applies to this employee
  esiEnabled         Boolean  @default(false) // ESI deduction applies to this employee
  fcmToken           String? // FCM device token for push notifications
  status             String   @default("ACTIVE") // EmployeeStatus
  joiningDate        DateTime
  salary             Float

  branch        Branch         @relation(fields: [branchId], references: [id])
  department    Department     @relation(fields: [departmentId], references: [id])
  designation   Designation    @relation(fields: [designationId], references: [id])
  shift         Shift          @relation(fields: [shiftId], references: [id])
  attendances   Attendance[]
  leaves        Leave[]
  payslips      Payslip[]
  leaveBalances LeaveBalance[]
  claims        Claim[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, phone])
  @@index([tenantId, branchId])
  @@index([tenantId, departmentId])
  @@index([tenantId, shiftId])
  @@index([tenantId, status])
}

model Attendance {
  id             String    @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId       String
  employeeId     String
  date           DateTime
  checkIn        DateTime?
  checkOut       DateTime?
  checkInSelfie  String? // Cloudinary URL
  checkOutSelfie String?
  checkInLat     Float?
  checkInLng     Float?
  checkOutLat    Float?
  checkOutLng    Float?
  checkInDevice  String?
  geofenceStatus String    @default("INSIDE") // GeofenceStatus
  faceMatchScore Float? // 0-100
  status         String    @default("PRESENT") // AttendanceStatus
  workingMinutes Int?
  isFlagged      Boolean   @default(false)
  flagReason     String?
  // Out-of-geofence check-ins need HR/admin sign-off before they count:
  // null = normal, PENDING = awaiting review, APPROVED / REJECTED = decided.
  approvalStatus String?
  approvedBy     String? // admin id who decided
  approvedAt     DateTime?
  // How the punch was made: GEO (normal selfie + geofence), MANUAL (typed times,
  // no selfie) or SELFIE (selfie only — geofence/face/shift checks skipped).
  // MANUAL/SELFIE punches always start as PENDING and pay only once approved.
  punchMode      String    @default("GEO")
  punchReason    String? // employee's justification for a manual / selfie punch
  raisedBy       String? // admin id when HR raised the punch on the employee's behalf

  employee Employee @relation(fields: [employeeId], references: [id])
  gpsLogs  GPSLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@index([tenantId, approvalStatus])
}

model GPSLog {
  id           String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId     String
  attendanceId String
  lat          Float
  lng          Float
  accuracy     Float?
  timestamp    DateTime

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, attendanceId])
}

model Branch {
  id              String  @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId        String
  name            String
  address         String
  geofenceLat     Float
  geofenceLng     Float
  geofenceRadius  Float   @default(100) // meters
  geofencePolygon String? // JSON-encoded polygon points (for polygon geofence)
  strictMode      Boolean @default(true)

  employees          Employee[]
  geofenceViolations GeofenceViolation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Department {
  id        String     @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId  String
  name      String
  employees Employee[]
  createdAt DateTime   @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Designation {
  id        String     @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId  String
  name      String
  employees Employee[]
  createdAt DateTime   @default(now())

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Shift {
  id             String  @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId       String
  name           String // "Morning Shift"
  startTime      String // "09:00"
  endTime        String // "18:00"
  gracePeriod    Int     @default(15) // minutes — late tolerance after start time
  otAfterMinutes Int     @default(0) // OT counts for duty time past (shift end + this many minutes)
  isNightShift   Boolean @default(false)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Leave {
  id           String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId     String
  employeeId   String
  type         String // LeaveType
  fromDate     DateTime
  toDate       DateTime
  days         Float
  reason       String
  documentUrl  String?
  status       String   @default("PENDING") // LeaveStatus
  approvedBy   String?
  approverNote String?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

model Claim {
  id             String    @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId       String
  // Human-facing running numbers, both printed on the voucher and both starting
  // at 1 (rendered zero-padded: 001, 002 …). They are separate sequences:
  //   claimNo   — allocated the moment the claim is received (every claim gets one)
  //   voucherNo — allocated only when the claim is APPROVED, so voucher numbers
  //               form an unbroken series across approved claims alone.
  claimNo        Int?
  voucherNo      Int?
  employeeId     String
  type           String // ClaimType — see services/claim/claim-types.ts
  title          String
  amount         Float
  description    String?
  photoFileId    String? // Google Drive file id (receipt photo)
  documentFileId String? // Google Drive file id (PDF)
  photoUrl       String? // fallback (S3/local) when Drive isn't configured
  documentUrl    String?
  status         String    @default("PENDING") // ClaimStatus
  reviewedBy     String? // admin id who acted
  reviewedAt     DateTime? // when the approve/reject decision was made
  reviewerNote   String? // admin note: rejection reason OR clarification question
  employeeNote   String? // employee's reply when resubmitting after clarification
  paidBy         String? // admin (cashier) id who disbursed the amount
  paidAt         DateTime?
  paidNote       String? // cashier note at disbursement

  employee Employee       @relation(fields: [employeeId], references: [id])
  messages ClaimMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, claimNo])
  @@unique([tenantId, voucherNo])
  @@index([tenantId, status])
  @@index([tenantId, employeeId])
}

// Clarification conversation on a claim: approver questions + employee replies.
model ClaimMessage {
  id         String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId   String
  claimId    String
  senderRole String // "ADMIN" | "EMPLOYEE"
  senderId   String // adminId or employeeId
  senderName String // denormalised for display
  message    String
  createdAt  DateTime @default(now())

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([tenantId, claimId])
}

model LeaveBalance {
  id         String @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId   String
  employeeId String
  type       String // LeaveType
  year       Int
  total      Float  @default(0)
  used       Float  @default(0)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, type, year])
  @@index([tenantId, year])
}

model Payslip {
  id              String    @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId        String
  employeeId      String
  month           Int
  year            Int
  // Fractional — a half day counts 0.5 on both presentDays and absentDays
  // (2 absents + 1 half day reads as 2.5 absent).
  presentDays     Float
  absentDays      Float
  halfDays        Float     @default(0)
  lopDays         Float
  // Casual-leave days consumed this month and the money withheld for the
  // days that were not paid (absent + LOP), both shown on the payroll report.
  clDays          Float     @default(0)
  leaveDeduction  Float     @default(0)
  perDaySalary    Float     @default(0)
  daysInMonth     Int       @default(30)
  // OT & Sunday-duty metrics (owner policy: >10h/day accrues OT; 10 OT hours = 1 day's pay)
  otHours         Float     @default(0)
  otDays          Float     @default(0)
  otPay           Float     @default(0)
  sundayDays      Int       @default(0)
  sundayPay       Float     @default(0)
  // Late-punch discipline: count of LATE days; pay date shifts / slip withheld per policy
  lateDays        Int       @default(0)
  payDate         DateTime?
  basicSalary     Float
  hra             Float
  da              Float
  otherAllowances Float
  grossSalary     Float
  pfDeduction     Float
  esiDeduction    Float
  ptDeduction     Float
  tdsDeduction    Float
  otherDeductions Float
  netSalary       Float
  pdfUrl          String?
  status          String    @default("DRAFT") // PayslipStatus

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month, year])
  @@index([tenantId, year, month])
}

// In-app notifications for admins/cashiers (claims workflow, branch-scoped).
model Notification {
  id        String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId  String
  adminId   String // recipient AdminUser
  type      String // CLAIM_SUBMITTED | CLAIM_APPROVED
  title     String
  body      String
  claimId   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, adminId, isRead])
}

model WhatsAppLog {
  id           String    @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId     String
  employeeId   String?
  phone        String
  templateName String
  message      String
  status       String    @default("QUEUED") // WAStatus
  messageId    String? // Meta's message ID
  sentAt       DateTime?
  deliveredAt  DateTime?
  readAt       DateTime?
  trigger      String // "CHECK_IN" | "PAYSLIP" | "LEAVE_APPROVED" etc.

  createdAt DateTime @default(now())

  @@index([tenantId, status])
  @@index([tenantId, phone])
}

model GeofenceViolation {
  id         String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId   String
  employeeId String
  branchId   String
  lat        Float
  lng        Float
  distance   Float // meters from boundary
  timestamp  DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId, timestamp])
  @@index([tenantId, employeeId])
  @@index([tenantId, branchId])
}

// ─────────────────────────────────────────────────────────────
// Auth / OTP / RBAC / Audit
// ─────────────────────────────────────────────────────────────
model AdminUser {
  id           String  @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId     String
  name         String
  email        String
  passwordHash String
  role         String  @default("HR_MANAGER") // AdminRole
  branchId     String? // null = all branches (for super admin)
  isActive     Boolean @default(true)

  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fcmToken  String? // FCM device token for push notifications

  @@unique([tenantId, email])
  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId  String
  adminId   String
  action    String
  entity    String
  entityId  String?
  metadata  String? // JSON-encoded metadata
  ipAddress String?
  timestamp DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([tenantId, timestamp])
  @@index([tenantId, entity])
  @@index([tenantId, adminId])
}

/// Everything that varies per dealer.
///
/// Was `CompanySettings`, a single row for the one company this system used to
/// serve. It is now one row per tenant and carries what used to be
/// process-wide environment variables — a dealer in another state needs its own
/// timezone, its own pay day and its own half-day window, and none of that can
/// be a deployment-level constant any more.
///
/// The external-resource names are stored explicitly rather than derived from
/// the slug, so the first dealer keeps the collection and S3 keys it already
/// has and nothing has to be moved or re-enrolled.
///
/// Mapped to the old table name: renaming the model is a rename in code only.
model TenantSettings {
  id       String @id @default(cuid())
  /// Owning tenant. Every query is filtered by this automatically — see
  /// context/tenant-scope.ts for the rule and plugins/prisma.ts for the wiring.
  tenantId String

  // ── Company profile, printed on payslips and reports ──
  name    String @default("")
  address String @default("")
  phone   String @default("")
  email   String @default("")
  gstin   String @default("")

  // ── Attendance policy (was COMPANY_TZ, HALF_DAY_WINDOW_*, …) ──
  timezone              String  @default("Asia/Kolkata")
  employeeCodePrefix    String  @default("EMP")
  halfDayWindowStart    String  @default("12:30")
  halfDayWindowEnd      String  @default("14:00")
  lateRequiresApproval  Boolean @default(true)
  openPunchLookbackDays Int     @default(7)

  // ── Payroll policy (was PAYROLL_*, and hardcoded constants) ──
  monthDivisor            Int @default(30) // per-day salary = monthly / this
  clPerYear               Int @default(12) // paid casual leave before it becomes LOP
  otHoursPerDay           Int @default(10) // OT hours that add up to one day's pay
  payrollLateShiftAt      Int @default(5) // late punches that push the pay date out
  payrollLateWithholdOver Int @default(8) // late punches that withhold the slip
  payrollPayDay           Int @default(5) // normal pay date, day of the next month
  payrollPayDayLate       Int @default(8) // shifted pay date

  // ── External resources, one set per dealer ──
  faceMatchThreshold      Int     @default(85)
  /// Rekognition collection. Per tenant so one dealer's enrolled faces can
  /// never match another's — the collection is the isolation boundary here.
  rekognitionCollectionId String?
  /// Prefix for this tenant's S3 keys, e.g. "t/abc-motors/". Empty for the
  /// original dealer, whose objects already live at the bucket root.
  s3Prefix                String  @default("")
  driveParentFolderId     String?
  driveShareWith          String?
  /// SHARED = the platform's WhatsApp number; OWN = this dealer's own account.
  whatsappMode            String  @default("SHARED")
  whatsappConfig          String? // JSON, only when whatsappMode is OWN

  updatedAt DateTime @updatedAt

  @@unique([tenantId])
  @@map("CompanySettings")
}

model Holiday {
  id       String   @id @default(cuid())
  /// Owning tenant. Every query is filtered by this via the Prisma extension
  /// in plugins/prisma.ts — see context/tenant-scope.ts for the rule.
  tenantId String
  name     String
  date     DateTime

  @@unique([tenantId, date])
}

// ─────────────────────────────────────────────────────────────
// Platform layer — above tenancy. Never carries a tenantId, and the
// tenant-scoping Prisma extension treats both as global models.
// ─────────────────────────────────────────────────────────────

/// A customer company. `slug` is the subdomain label: "acme" → acme.yourapp.com.
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  status    String   @default("ACTIVE") // TenantStatus
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Platform super admin. Separate from AdminUser: platform staff are not
/// members of any tenant, and AdminUser is itself tenant-scoped.
model PlatformUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Platform-level actions: a dealer onboarded, suspended, or issued credentials.
///
/// Separate from AuditLog, which is tenant-scoped and whose actor is an
/// AdminUser. Here the actor is platform staff and the action often precedes
/// the tenant existing, so it cannot be scoped to one. `targetTenantId` is the
/// tenant acted upon — deliberately not named `tenantId`, because this model is
/// global and must never be picked up as a tenant-owned row.
model PlatformAuditLog {
  id             String   @id @default(cuid())
  platformUserId String
  action         String // TENANT_CREATED | TENANT_SUSPENDED | TENANT_RESUMED | TENANT_ADMIN_CREATED
  targetTenantId String?
  targetId       String? // the row acted on, e.g. the AdminUser created
  metadata       String? // JSON-encoded detail
  ipAddress      String?
  timestamp      DateTime @default(now())

  @@index([platformUserId])
  @@index([targetTenantId])
  @@index([timestamp])
}
